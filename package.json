{
  "name": "raseo-sdk",
  "version": "0.2.0",
  "description": "The open-source Agent SDK",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tool": {
      "types": "./dist/tool/index.d.ts",
      "import": "./dist/tool/index.js",
      "require": "./dist/tool/index.cjs"
    },
    "./openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.js",
      "require": "./dist/providers/openai.cjs"
    },
    "./anthropic": {
      "types": "./dist/providers/anthropic.d.ts",
      "import": "./dist/providers/anthropic.js",
      "require": "./dist/providers/anthropic.cjs"
    },
    "./gemini": {
      "types": "./dist/providers/gemini.d.ts",
      "import": "./dist/providers/gemini.js",
      "require": "./dist/providers/gemini.cjs"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js",
      "require": "./dist/session/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeamRaseo/raseo-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/TeamRaseo/raseo-sdk/issues"
  },
  "homepage": "https://github.com/TeamRaseo/raseo-sdk#readme",
  "keywords": [
    "ai",
    "agent",
    "sdk",
    "llm",
    "openai",
    "gemini",
    "anthropic",
    "typescript"
  ],
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "openai": "^7.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "5.7.3"
  }
}
